# Copy to .env beside app.py (or beside DriftTool.exe) and fill in. Gitignored.
# Loaded automatically at startup; real environment variables take precedence.

# Restore .bak files on a SQL Server on this machine (no Docker). Leave unset to use Docker.
# Named instance: localhost\SQLEXPRESS. The login needs dbcreator or sysadmin.
# DRIFT_SCRATCH_SERVER=localhost
# DRIFT_SCRATCH_PORT=1433
# DRIFT_SCRATCH_USER=drift
# DRIFT_SCRATCH_PASSWORD=

# Docker mode only. If unset, a strong password is generated once and kept in work/.mssql_pw.
# If you set it: 8+ chars with upper, lower, digit and symbol (SQL Server rule), and
# recreate the container after changing it: docker rm -f drift-tool-mssql
# DRIFT_MSSQL_SA_PASSWORD=

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
